<?xml version='1.0' encoding='utf-8'?>
<widget id="com.exemplo.App3fit" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <feature name="Keyboard">
        <param name="android-package" onload="true" value="org.apache.cordova.labs.keyboard.Keyboard" />
    </feature>
    <name>App3fit</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="https://script.google.com/*" />
    <icon src="res/mipmap-anydpi-v26/icon_3fit.xml" />
    <icon background="res/mipmap-mdpi/icon_3fit_background.png" density="mdpi" foreground="res/mipmap-mdpi/icon_3fit_foreground.png" monochrome="res/mipmap-mdpi/icon_3fit_monochrome.png" />
    <icon background="res/mipmap-hdpi/icon_3fit_background.png" density="hdpi" foreground="res/mipmap-hdpi/icon_3fit_foreground.png" monochrome="res/mipmap-hdpi/icon_3fit_monochrome.png" />
    <icon background="res/mipmap-xhdpi/icon_3fit_background.png" density="xhdpi" foreground="res/mipmap-xhdpi/icon_3fit_foreground.png" monochrome="res/mipmap-xhdpi/icon_3fit_monochrome.png" />
    <icon background="res/mipmap-xxhdpi/icon_3fit_background.png" density="xxhdpi" foreground="res/mipmap-xxhdpi/icon_3fit_foreground.png" monochrome="res/mipmap-xxhdpi/icon_3fit_monochrome.png" />
    <icon background="res/mipmap-xxxhdpi/icon_3fit_background.png" density="xxxhdpi" foreground="res/mipmap-xxxhdpi/icon_3fit_foreground.png" monochrome="res/mipmap-xxxhdpi/icon_3fit_monochrome.png" />
    <preference name="loglevel" value="DEBUG" />
    <preference name="Fullscreen" value="false" />
    <preference name="android-windowSoftInputMode" value="adjustResize" />
</widget>
